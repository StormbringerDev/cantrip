{
  "name": "cantrip-repl-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cantrip-ts": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "check": "tsc -p tsconfig.json --noEmit && eslint src --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cantrip/interpreter": "workspace:*",
    "@cantrip/ast": "workspace:*",
    "@cantrip/parser": "workspace:*",
    "@cantrip/types": "workspace:*",
    "prompt-sync": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/prompt-sync": "^4.2.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
